rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Règles pour la collection tasks
    match /tasks/{taskId} {
      // Permettre la lecture à tous
      allow read: if true;
      
      // Permettre la création, modification et suppression à tous
      // Note: Pour plus de sécurité, vous pouvez ajouter l'authentification plus tard
      allow create, update, delete: if true;
    }
    
    // Règles pour la collection family_members
    match /family_members/{memberId} {
      // Permettre la lecture à tous
      allow read: if true;
      
      // Permettre la modification des statistiques
      allow update: if true;
      
      // Empêcher la création et suppression (données fixes)
      allow create, delete: if false;
    }
  }
}
